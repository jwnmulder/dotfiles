{{ if .is_desktop -}}

chezmoi() {
    if [[ "${1:-}" == "apply" || "${1:-}" == "update" ]]; then
        local github_token="${CHEZMOI_GITHUB_ACCESS_TOKEN:-}"
        if [[ -z "$github_token" ]]; then
            github_token="$(command chezmoi secret keyring get --service=github --user=chezmoi-github)"
        fi
        if [[ -z "$github_token" ]]; then
            echo "Running chezmoi without CHEZMOI_GITHUB_ACCESS_TOKEN set"
            echo "Configure keyring using: chezmoi secret keyring set --service=github --user=chezmoi-github"
        fi

        if ! command -v busctl >/dev/null 2>&1 || ! busctl --user --no-pager list 2>/dev/null | grep -q 'org.freedesktop.secrets'; then
            echo "No keyring service appears to be running, install one using: sudo apt install gnome-keyring libsecret-tools"
            echo "If needed, initialize a new default kyring using: secret-tool store --label="Chezmoi readonly GitHub token" service github username chezmoi-github"
        fi
        CHEZMOI_GITHUB_ACCESS_TOKEN="$github_token" command chezmoi "$@"
    else
        command chezmoi "$@"
    fi
}

{{ end -}}
