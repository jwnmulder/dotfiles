# XDG folders
$XdgConfigHome = if ($env:XDG_CONFIG_HOME) { $env:XDG_CONFIG_HOME } else { [IO.Path]::Combine($env:HOME, ".config") }
$XdgDataHome = if ($env:XDG_DATA_HOME) { $env:XDG_DATA_HOME } else { [IO.Path]::Combine($env:HOME, '.local', 'share') }

# Prefer local module path; drop OneDrive Documents redirection (slow completion)
$ModuleHome = [IO.Path]::Combine($XdgDataHome, "powershell", "Modules")
$env:PSModulePath = @(
  $ModuleHome
  ($env:PSModulePath -split [IO.Path]::PathSeparator |
    Where-Object {
      $_ -and
      ($_ -ne $ModuleHome) -and
      ($_ -notmatch '(?i)OneDrive.*Documents.*PowerShell.*Modules')
    })
) -join [IO.Path]::PathSeparator

# Only continue loading the rest of the profile in interactive mode
function Test-IsInteractive {
    $commandLineArgs = [System.Environment]::GetCommandLineArgs()

    # True if VS Code shell integration is sourced: . "...\Microsoft VS Code\...\shellIntegration.ps1"
    # This is done in the integrated terminal
    if ($commandLineArgs -match '\.\s*\u0022.*vs\s*code.*shellIntegration\.ps1\u0022') {
        return $true
    }

    # False if the command line arguments contain any non-interactive parameters
    if ($commandLineArgs -imatch '-noni(?:n(?:t(?:e(?:r(?:a(?:c(?:t(?:i(?:ve?)?)?)?)?)?)?)?)?)?') {
        return $false
    }

    return [System.Environment]::UserInteractive
}

# $IsPwsh = $PSVersionTable.PSEdition -eq 'Core'
$IsInteractive = Test-IsInteractive
if (-not $IsInteractive) {
    Write-Host "done"
    return
}

# Aliases
Set-Alias do-upgrade-all "$XdgConfigHome\powershell\do-upgrade-all.ps1"

# Completions
. "$XdgConfigHome\powershell\completions\_chezmoi.ps1"

# PSReadLine options
Set-PSReadLineOption -EditMode Windows
Set-PSReadLineKeyHandler -Chord Tab -Function MenuComplete

{{ if (lookPath "az") -}}

# Azure CLI
Register-ArgumentCompleter -Native -CommandName az -ScriptBlock {
    param($commandName, $wordToComplete, $cursorPosition)
    $completion_file = New-TemporaryFile
    $env:ARGCOMPLETE_USE_TEMPFILES = 1
    $env:_ARGCOMPLETE_STDOUT_FILENAME = $completion_file
    $env:COMP_LINE = $wordToComplete
    $env:COMP_POINT = $cursorPosition
    $env:_ARGCOMPLETE = 1
    $env:_ARGCOMPLETE_SUPPRESS_SPACE = 0
    $env:_ARGCOMPLETE_IFS = "`n"
    $env:_ARGCOMPLETE_SHELL = 'powershell'
    az 2>&1 | Out-Null
    Get-Content $completion_file | Sort-Object | ForEach-Object {
        [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }
    Remove-Item $completion_file, Env:\_ARGCOMPLETE_STDOUT_FILENAME, Env:\ARGCOMPLETE_USE_TEMPFILES, Env:\COMP_LINE, Env:\COMP_POINT, Env:\_ARGCOMPLETE, Env:\_ARGCOMPLETE_SUPPRESS_SPACE, Env:\_ARGCOMPLETE_IFS, Env:\_ARGCOMPLETE_SHELL
}

{{- end }}

{{ if stat (joinPath .chezmoi.homeDir "AppData/Local/starship/starship.exe") -}}
# Starship
$env:STARSHIP_CONFIG = "$HOME\AppData\Local\starship\starship.toml"

# https://github.com/starship/starship/issues/2057#issuecomment-831336770
&"$HOME\AppData\Local\starship\starship.exe" init powershell --print-full-init | Out-String | Invoke-Expression

{{ else }}
# When Starship is not available, fallback to classic prompt
function prompt {
    $path = (Get-Location).Path

    if ($path -eq $HOME) {
        $path = '~'
    }
    elseif ($path.StartsWith($HOME)) {
        $path = '~' + $path.Substring($HOME.Length)
    }

    $cyan  = "`e[1;36m"
    $green = "`e[32m"
    $reset = "`e[0m"

    "PS ${cyan}${path} ${green}❯${reset} "
}
{{- end }}
