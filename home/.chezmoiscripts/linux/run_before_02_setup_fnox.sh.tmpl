{{ if .is_desktop -}}
#!/usr/bin/env bash

set -euo pipefail

{{ if not (stat (joinPath .chezmoi.homeDir ".config/fnox/age.txt")) }}

echo "Generating unique fnox age identity for this machine under ~/.config/fnox/age.txt"
mkdir -p ~/.config/fnox
chezmoi age-keygen -o ~/.config/fnox/age.txt

{{ end -}}

{{ end -}}
