{{ if .is_desktop -}}
#!/usr/bin/env bash

set -euo pipefail

if ! command -v busctl >/dev/null 2>&1 || ! busctl --user --no-pager list 2>/dev/null | grep -q 'org.freedesktop.secrets'; then
    echo "No keyring service appears to be running, install one using: sudo apt install gnome-keyring libsecret-tools"
    echo "If needed, initialize a new default kyring using: secret-tool store --label="test" service test"
fi

{{ if not (stat (joinPath .chezmoi.homeDir ".config/fnox/age-local.pub")) }}
echo "Generating new fnox age identity for this machine under ~/.config/fnox/age-local.txt"
mkdir -p ~/.config/fnox
chezmoi --use-builtin-age true age-keygen -o ~/.config/fnox/age-local.txt
grep '^# public key:' ~/.config/fnox/age-local.txt | sed 's/^# public key: //' > ~/.config/fnox/age-local.pub
{{ end -}}

{{ end -}}
